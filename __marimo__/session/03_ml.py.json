          "data": {
            "text/html": "<span class=\"markdown prose dark:prose-invert\"><h2 id=\"utility-functions\">Utility Functions</h2>\n<span class=\"paragraph\">Mathematical transformations and helper functions for bounded variable handling,\nphase relationships, and model evaluation metrics.</span></span>"
